{
  "name": "connection-scan-algorithm",
  "version": "3.0.0",
  "description": "Connection Scan Algorithm",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/connection-scan-algorithm.git"
  },
  "scripts": {
    "test": "npm run lint && npm run typecheck && vitest run",
    "gtest": "vitest run -t",
    "watch-test": "vitest",
    "typecheck": "tsc --noEmit -p ./",
    "build": "rm -rf ./dist/ && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && cp cjs-package.json dist/cjs/package.json && cp esm-package.json dist/esm/package.json",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "release": "changeset publish",
    "lint": "biome lint src/ test/",
    "int": "tsx ./test/integration.ts",
    "perf": "tsx ./test/performance.ts"
  },
  "keywords": [
    "Journey",
    "Planning",
    "Public",
    "Transport"
  ],
  "author": "Linus Norton <linusnorton@gmail.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/connection-scan-algorithm/issues"
  },
  "homepage": "https://github.com/planarnetwork/connection-scan-algorithm#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "^3.0.2",
    "@types/node": "26.5.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@gb-transit/gtfs-loader": "^1.4.0"
  }
}
